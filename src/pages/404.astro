---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Button from "@/components/ui/Button.astro";
import Rule from "@/components/ui/Rule.astro";
import Stage from "@/components/ui/Stage.astro";
import { SITE } from "@/constants/site.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title={`Page not found — ${SITE.name}`}>
  <Header />
  <main>
    <Stage class="reveal">
      <p class="eyebrow">Malmesbury · Wiltshire</p>
      <h1 class="code">404</h1>
      <Rule />
      <p class="stage-tag notfound-tag">This chair's empty by mistake.</p>
      <p class="stage-sub">
        The page you're looking for has been trimmed away. Let's get you back to somewhere
        familiar.
      </p>
      <div class="stage-cta">
        <Button href="/" variant="solid">Back to home</Button>
        <Button href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</Button>
      </div>
    </Stage>
  </main>
  <Footer />
</BaseLayout>

<style>
  .code {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    font-size: clamp(5rem, 16vw, 9rem);
    line-height: 1;
    color: var(--color-ivory);
    margin: 0 0 1.6rem;
  }

  .notfound-tag {
    margin-top: 1.8rem;
  }
</style>
