---
import AboutSection from "@/components/AboutSection.astro";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import NavDrawer from "@/components/NavDrawer.astro";
import PageHeader from "@/components/PageHeader.astro";
import Prose from "@/components/Prose.astro";
import { ABOUT_COPY, ABOUT_PAGE } from "@/constants/pages.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={ABOUT_PAGE.title}
  description={ABOUT_PAGE.description}
  markdownPath={ABOUT_PAGE.markdownPath}
>
  <Nav />
  <NavDrawer />
  <main id="main">
    <PageHeader eyebrow="About" title="About the salon" lede={ABOUT_COPY.intro} />
    <AboutSection />
    <Prose>
      <h2>Products</h2>
      <p>{ABOUT_COPY.products}</p>
      <h2>Booking</h2>
      <p>{ABOUT_COPY.booking}</p>
      <p><a href="/#services">See the price list</a> or <a href="/contact">get in touch</a>.</p>
    </Prose>
  </main>
  <Footer />
</BaseLayout>
