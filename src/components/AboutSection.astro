---
import Button from "@/components/ui/Button.astro";
import Rule from "@/components/ui/Rule.astro";
import { POINTS } from "@/constants/content.ts";
import { SITE } from "@/constants/site.ts";
---

<section class="section light" id="about">
  <div class="wrap about-grid">
    <div class="reveal">
      <p class="eyebrow">About</p>
      <h2>More than a haircut</h2>
      <Rule align="left" />
      <p class="lede">
        Nicolas Heaton is a small, independent salon in Malmesbury. The aim is hair that looks
        right on the day and is easy to manage between visits.
      </p>
      <p>
        Every appointment starts with a consultation, so the cut suits your hair, your routine and
        how you wear it. No upselling, and the price is confirmed before anything starts.
      </p>
      <Button href={`tel:${SITE.phone}`} variant="on-light" class="mt-[0.8rem]">
        Call to book
      </Button>
    </div>
    <ul class="points reveal" data-delay="1">
      {POINTS.map((point) => (
        <li>
          <span class="mark" />
          <div>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(36px, 6vw, 90px);
    align-items: center;
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .points li {
    display: flex;
    gap: 1.1rem;
    padding: 1.35rem 0;
    border-top: 1px solid rgba(20, 18, 16, 0.12);
  }

  .points li:last-child {
    border-bottom: 1px solid rgba(20, 18, 16, 0.12);
  }

  .points .mark {
    flex: 0 0 26px;
    width: 26px;
    height: 26px;
    margin-top: 0.3rem;
    position: relative;
  }

  .points .mark::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 13px;
    height: 13px;
    margin: -6.5px 0 0 -6.5px;
    border: 1px solid var(--color-brass);
    transform: rotate(45deg);
  }

  .points .mark::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1px;
    height: 24px;
    margin: -12px 0 0 -0.5px;
    background: var(--color-brass);
    opacity: 0.45;
  }

  .points h3 {
    font-size: 1.12rem;
    margin-bottom: 0.25rem;
    color: var(--color-ink);
  }

  .points p {
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 940px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>