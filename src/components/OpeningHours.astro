---
import { OPENING_HOURS } from "@/constants/content.ts";
import { formatDay, isTrading } from "@/lib/hours.ts";

const rows = OPENING_HOURS.map((day) => ({
  index: day.index,
  name: day.name,
  hours: formatDay(day),
  closed: !isTrading(day),
}));
---

<div class="panel frame">
  <h3>Opening hours</h3>
  <p class="status" id="status" hidden></p>
  <ul class="hours" id="hours">
    {
      rows.map((row) => (
        <li data-index={row.index} class={row.closed ? "shut" : undefined}>
          <span class="day">{row.name}</span>
          <span class="hrs">{row.hours}</span>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { currentStatus } from "@/lib/hours.ts";

  const list = document.getElementById("hours");
  const statusEl = document.getElementById("status");

  if (list && statusEl) {
    const status = currentStatus();

    statusEl.textContent = status.label;
    statusEl.classList.toggle("open", status.open);
    statusEl.hidden = false;

    const today = list.querySelector(`[data-index="${status.today}"]`);
    today?.classList.add("today");
    const dayEl = today?.querySelector(".day");
    if (dayEl) dayEl.textContent = `Today · ${dayEl.textContent}`;
  }
</script>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: -0.5rem 0 1.15rem;
    font-size: 0.68rem;
    letter-spacing: var(--tracking-mid);
    text-transform: uppercase;
    color: var(--color-ash);
  }

  .status[hidden] {
    display: none;
  }

  .status::before {
    content: "";
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: var(--text-ash-faint);
  }

  .status.open {
    color: var(--color-champagne);
  }

  .status.open::before {
    background: var(--color-brass);
    box-shadow: 0 0 0 4px var(--line-brass-soft);
  }

  .hours {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--line-brass-soft);
    font-size: 0.92rem;
    letter-spacing: 0.03em;
  }

  .hours li:last-child {
    border-bottom: 0;
  }

  .hours span:first-child {
    color: var(--color-ivory);
  }

  .hours span:last-child {
    color: var(--color-ash);
  }

  .hours .shut .hrs {
    color: var(--text-ash-faint);
  }

  .hours li.today {
    position: relative;
    padding-left: 1.1rem;
  }

  .hours li.today::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -4px;
    transform: rotate(45deg);
    border: 1px solid var(--color-brass);
  }

  .hours li.today .day {
    color: var(--color-champagne);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .hours li.today .hrs,
  .hours li.today.shut .hrs {
    color: var(--color-brass);
    font-weight: 500;
  }
</style>
