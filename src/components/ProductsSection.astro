---
import Rule from "@/components/ui/Rule.astro";
import { PRODUCTS } from "@/constants/content.ts";
---

<section class="products" id="products">
  <div class="wrap">
    <p class="eyebrow">Products</p>
    <h2>What we use</h2>
    <Rule tight class="mt-[1.2rem] mb-0" />
    <div class="partner-row">
      {PRODUCTS.map((product) => (
        <a
          href={product.url}
          target="_blank"
          rel="external noopener noreferrer"
          aria-label={`${product.name} website`}
        >
          <img src={product.image} alt={`${product.name} logo`} />
        </a>
      ))}
    </div>
    <p class="partner-note">
      Goldwell colour and KMS care and styling, used in the salon and available to buy.
    </p>
  </div>
</section>

<style>
  .products {
    background: var(--color-ivory-shade);
    color: var(--color-ink);
    padding-block: clamp(38px, 6vw, 64px);
    text-align: center;
  }

  .products .eyebrow {
    color: #8a6f3e;
  }

  .products h2 {
    color: var(--color-ink);
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
  }

  .partner-note {
    font-size: 0.86rem;
    color: var(--color-ink-muted);
    margin: 1.8rem auto 0;
  }

  .partner-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(28px, 7vw, 90px);
    margin-top: clamp(28px, 4vw, 46px);
  }

  .partner-row a {
    display: flex;
    align-items: center;
  }

  .partner-row img {
    height: 68px;
    width: auto;
    max-width: 320px;
    object-fit: contain;
  }
</style>