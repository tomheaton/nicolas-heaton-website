---
import Logo from "@/assets/logo.svg";
import HeroFan from "@/components/HeroFan.astro";
import Button from "@/components/ui/Button.astro";
import Stage from "@/components/ui/Stage.astro";
import { SITE } from "@/constants/site.ts";
---

<Stage id="top" scrim>
  <HeroFan slot="backdrop" />
  <Logo class="hero-logo" role="img" aria-label="Nicolas Heaton Hairdresser" />
  <p class="eyebrow">Malmesbury · Wiltshire · Est. 2002</p>
  <h1 class="stage-tag">Considered hair, cut with precision.</h1>
  <p class="stage-sub">
    Cuts, colour and finishing for every kind of hair, on Griffin Alley in Malmesbury.
    Appointments by phone.
  </p>
  <div class="stage-cta">
    <Button href={`tel:${SITE.phone}`} variant="solid">
      Call {SITE.phoneDisplay}
    </Button>
    <Button href="/#services">See the price list</Button>
  </div>
</Stage>

<style>
  .eyebrow {
    margin: 2.2rem 0 1rem;
  }

  .hero-logo {
    width: min(520px, 74vw);
    aspect-ratio: 1.1839;
    height: auto;
    color: var(--color-ivory);
    animation: rise 1s ease 0.35s both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo {
      opacity: 1;
    }
  }
</style>
