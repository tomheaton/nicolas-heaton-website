---
import Logo from "@/assets/logo.svg";
import HeroFan from "@/components/HeroFan.astro";
import Button from "@/components/ui/Button.astro";
import { SITE } from "@/constants/site.ts";
---

<section class="hero" id="top">
  <HeroFan />
  <div class="hero-inner">
    <Logo class="hero-logo" role="img" aria-label="Nicolas Heaton Hairdresser" />
    <p class="eyebrow">Malmesbury, Wiltshire · Est. 2002</p>
    <h1 class="hero-tag">Considered hair, cut with precision.</h1>
    <p class="hero-sub">
      A calm, unhurried chair where every cut, colour and finish is shaped around you, and built
      to grow out beautifully. Appointments by phone.
    </p>
    <div class="hero-cta">
      <Button href={`tel:${SITE.phone}`} variant="solid">
        Call {SITE.phoneDisplay}
      </Button>
      <Button href="/#services">Price list</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(88svh, 860px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(96px, 12vh, 140px) var(--gutter) clamp(56px, 8vh, 96px);
    overflow: hidden;
    background: radial-gradient(
      120% 80% at 50% 20%,
      #1f1b18 0%,
      var(--color-onyx) 55%,
      var(--color-onyx-deep) 100%
    );
  }

  /* scrim: keeps the lockup and copy readable where the rays run behind them */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 48% 44% at 50% 44%,
        color-mix(in srgb, var(--color-onyx-deep) 90%, transparent) 0%,
        color-mix(in srgb, var(--color-onyx-deep) 60%, transparent) 52%,
        color-mix(in srgb, var(--color-onyx-deep) 0%, transparent) 78%
      ),
      linear-gradient(180deg, color-mix(in srgb, var(--color-onyx-deep) 80%, transparent) 0%, color-mix(in srgb, var(--color-onyx-deep) 0%, transparent) 20%),
      linear-gradient(0deg, color-mix(in srgb, var(--color-onyx-deep) 72%, transparent) 0%, color-mix(in srgb, var(--color-onyx-deep) 0%, transparent) 16%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .hero-logo {
    width: min(380px, 64vw);
    aspect-ratio: 1.1839;
    height: auto;
    color: var(--color-ivory);
    animation: rise 1s ease 0.35s both;
  }

  .hero .eyebrow {
    margin: 1.8rem 0 0.8rem;
  }

  .hero-tag {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    font-size: clamp(1.4rem, 3.3vw, 2.25rem);
    line-height: 1.24;
    max-width: 20ch;
    margin: 0 auto;
    color: var(--color-ivory);
  }

  .hero-sub {
    color: color-mix(in srgb, var(--color-ivory) 80%, transparent);
    max-width: 44ch;
    margin: 1.4rem auto 2.3rem;
    font-size: 1.02rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .hero::after {
      background:
        radial-gradient(
          ellipse 78% 42% at 50% 42%,
          color-mix(in srgb, var(--color-onyx-deep) 92%, transparent) 0%,
          color-mix(in srgb, var(--color-onyx-deep) 62%, transparent) 55%,
          color-mix(in srgb, var(--color-onyx-deep) 0%, transparent) 82%
        ),
        linear-gradient(180deg, color-mix(in srgb, var(--color-onyx-deep) 85%, transparent) 0%, color-mix(in srgb, var(--color-onyx-deep) 0%, transparent) 22%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo {
      opacity: 1;
    }
  }
</style>