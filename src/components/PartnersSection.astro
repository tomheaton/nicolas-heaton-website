---
import Rule from "@/components/ui/Rule.astro";
import { PARTNERS, PARTNERS_NOTE, PARTNERS_TITLE } from "@/constants/content.ts";
---

<section class="partners" id="partners">
  <div class="wrap">
    <p class="eyebrow">Partners</p>
    <h2>{PARTNERS_TITLE}</h2>
    <Rule tight class="mt-[1.2rem] mb-0" />
    <div class="partner-row">
      {PARTNERS.map((partner) => (
        <a
          href={partner.url}
          target="_blank"
          rel="external noopener noreferrer"
          aria-label={`${partner.name} website`}
        >
          <img src={partner.image} alt={`${partner.name} logo`} />
        </a>
      ))}
    </div>
    <p class="partner-note">{PARTNERS_NOTE}</p>
  </div>
</section>

<style>
  .partners {
    background: var(--color-ivory-shade);
    color: var(--color-ink);
    padding-block: clamp(38px, 6vw, 64px);
    text-align: center;
  }

  .partners .eyebrow {
    color: var(--color-brass-deep);
  }

  .partners h2 {
    color: var(--color-ink);
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
  }

  .partner-note {
    font-size: 0.86rem;
    color: var(--color-ink-muted);
    margin: 1.8rem auto 0;
  }

  .partner-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(28px, 7vw, 90px);
    margin-top: clamp(28px, 4vw, 46px);
  }

  .partner-row a {
    display: flex;
    align-items: center;
  }

  .partner-row img {
    height: 68px;
    width: auto;
    max-width: 320px;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .partner-row {
      gap: 28px 36px;
    }

    .partner-row img {
      height: 44px;
      max-width: min(60vw, 220px);
    }
  }
</style>