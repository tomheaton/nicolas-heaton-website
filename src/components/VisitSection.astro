---
import OpeningHours from "@/components/OpeningHours.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { SITE } from "@/constants/site.ts";
---

<section class="section" id="visit">
  <div class="wrap center">
    <SectionHead
      eyebrow="Visit"
      title="Find us"
      ruleClass="mt-6 mb-0"
    />
  </div>
  <div class="wrap visit-grid">
    <div>
      <OpeningHours />
      <div class="panel frame mt-5.5">
        <h3>Address</h3>
        <div class="addr">
          {SITE.addressLine1}
          <br />
          {SITE.addressLine2}
          <br />
          <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
          {" · "}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <div>
            <a
              class="w3w"
              href={`https://what3words.com/${SITE.what3words}`}
              target="_blank"
              rel="external noopener noreferrer"
            >
              what3words <em>///{SITE.what3words}</em>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="map frame">
      <iframe
        title="Map showing Nicolas Heaton, 16 Griffin Alley, Malmesbury"
        src={SITE.mapsEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <a
        class="btn"
        href={SITE.mapsDirectionsUrl}
        target="_blank"
        rel="external noopener noreferrer"
      >
        Directions
      </a>
    </div>
  </div>
</section>

<style>
  .visit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 3.4vw, 48px);
    align-items: stretch;
    margin-top: clamp(36px, 5vw, 56px);
  }

  .map {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-jade-deep);
    min-height: 520px;
  }

  .map iframe {
    flex: 1 1 auto;
    width: 100%;
    min-height: 400px;
    border: 0;
    display: block;
  }

  .map .btn {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 28%, transparent);
    justify-content: center;
    background: rgba(0, 0, 0, 0.4);
  }

  .addr {
    margin-top: 0;
    font-size: 0.95rem;
    color: var(--color-ash);
    line-height: 1.85;
  }

  .addr a {
    color: var(--color-champagne);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-champagne) 35%, transparent);
  }

  .addr a:hover {
    color: var(--color-brass);
  }

  .w3w {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    padding: 0.6rem 0.9rem;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--color-champagne);
  }

  .w3w em {
    font-style: normal;
    color: var(--color-brass);
    font-weight: 500;
  }

  @media (max-width: 940px) {
    .visit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
